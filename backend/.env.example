# GEBot backend — copy to .env and fill in real values.
# Required keys must be set before `npm run dev` or `npm run build`.

# --- Runtime ---
NODE_ENV=development
PORT=8787

# --- Security / HTTP ---
# Comma-separated extra CORS origins (WP_URL origin is added automatically).
CORS_ALLOWED_ORIGINS=
# Set to false only when not behind Nginx/reverse proxy.
USE_TRUST_PROXY=true
# Optional token for protected /health/detail in production (?token=...)
HEALTH_DETAIL_TOKEN=
SESSION_TOKEN_SECRET=
# Lifetime of signed session tokens in ms (default 24h).
SESSION_TOKEN_TTL_MS=86400000
# Set false to disable ipapi.co IP lookups (GDPR / no third-party geo).
GEOLOCATION_ENABLED=true
CHAT_MESSAGE_MAX_LENGTH=4000

# --- Mistral (required) ---
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_CHAT_FALLBACK_MODELS=
MISTRAL_CHAT_MAX_TOKENS=1280
MISTRAL_CHAT_MAX_RETRIES=3
MISTRAL_CHAT_RETRY_BASE_MS=1500
MISTRAL_EMBED_BATCH_SIZE=32
MISTRAL_EMBED_MIN_INTERVAL_MS=1100

# --- Supabase (required) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=documents

# --- WordPress catalogue source (required) ---
WP_URL=https://www.geb.fr
WP_USER=
WP_APP_PASSWORD=
WP_RESELLERS_ENDPOINT=/wp-json/wp/v2/resellers

# --- Retrieval / RAG tuning ---
TOP_K=24
RETRIEVAL_POOL_MULTIPLIER=3
DIAGNOSTIC_MAX_CONTEXT_NODES=128
PDF_CHUNKS_PER_SLUG=48
DIAGNOSTIC_MAX_SOURCE_URLS=12
CHAT_HISTORY_LIMIT=10
QUERY_CACHE_TTL_MS=120000
PRODUCT_KNOWLEDGE_ENABLED=true
PRODUCT_KNOWLEDGE_MAX_PRODUCTS=3
VECTOR_RAG_LITE=auto
FAQ_KNOWLEDGE_JSON_PATH=
FAQ_MATCH_MIN_SCORE=0.38

# --- Commerce links ---
AMAZON_STORE_URL=https://www.amazon.fr/s?k=GEB
AMAZON_PRODUCT_URL_MAP=
# Directory with amazon-links.fr.json / amazon-links.nl.json (default: backend/data).
AMAZON_LINKS_DATA_DIR=

